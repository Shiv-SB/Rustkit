{
  "name": "rustkit",
  "version": "0.1.0",
  "description": "High performance primitives for Bun, powered by Rust",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "platforms",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile:rs": "cargo build --release -p rustkit-ffi",
    "bench": "bun benchmarks/benchmark",
    "build": "bun scripts/build.ts",
    "build:platforms": "bun scripts/build-platforms.ts",
    "verify:platforms": "bun scripts/verify-platforms.ts",
    "smoke": "bun scripts/smoke-test.ts",
    "release": "bun scripts/release.ts",
    "sync:version": "bun scripts/sync-version.ts"
  },
  "license": "MIT",
  "keywords": [
    "bun",
    "bun-ffi",
    "rust",
    "crypto",
    "math",
    "bitset",
    "distance",
    "entropy",
    "geohash",
    "matrix",
    "quantile",
    "stats",
    "string",
    "vector"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shiv-SB/Rustkit.git"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "mitata": "^1.0.34",
    "typescript": "^7"
  },
  "sideEffects": false
}
